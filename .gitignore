# =====================================================================
#  Chỉ đưa lên git mã nguồn cần để build & deploy.
# =====================================================================

# ---------- Biến môi trường: KHÔNG BAO GIỜ đưa lên git ----------
# (.env, .env.dev, .env.deploy, .env.example, .env.local, ... ở mọi thư mục)
.env
.env.*
*.env

# ---------- Thư viện cài đặt (cài lại bằng npm ci) ----------
node_modules/
.npm/
.pnpm-store/
.yarn/

# ---------- Sản phẩm build (build lại trên server) ----------
dist/
build/
*.tsbuildinfo
.vite/

# ---------- Dữ liệu chạy (ảnh bài làm, học liệu, dữ liệu DB) ----------
backend/uploads/
uploads/
pgdata/
*.sqlite
*.dump
*.backup

# ---------- Log, báo cáo test, file tạm ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/
*.tmp
*.temp
tmp/
temp/
screenshots/
*.heapsnapshot

# ---------- Khóa / chứng chỉ ----------
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------- IDE / hệ điều hành ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.claude/
